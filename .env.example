# DeepSeek API key, get one at https://platform.deepseek.com
DS_API_KEY=

# Optional result storage. Overrides must be absolute paths (forward slashes work on Windows).
# DS_RESULT_DIR=C:/Users/your-name/.deepseek-search-mcp/results

# Per-representation JSON budget, including metadata and escaping; Unicode code points, not tokens.
DS_MAX_OUTPUT_CHARS=12000
DS_READ_DEFAULT_CHARS=4000

# Expire after 7 days; 512 MiB of managed result data plus metadata. Never evict unexpired results.
DS_RESULT_TTL_DAYS=7
DS_RESULT_MAX_BYTES=536870912
